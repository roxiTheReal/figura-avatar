function pings.typing()
nameplate.ENTITY:setText(string.sub(nameplate.ENTITY:getText(), 1, -2) .. "," .. string.sub(TypingNameplate,2, -1))
end

function pings.afk()
nameplate.ENTITY:setText(string.sub(nameplate.ENTITY:getText(), 1, -2) .. "," .. string.sub(AFKNameplate,2, -1))
end

function pings.defaultNP()
if isCat then
nameplate.ENTITY:setText(CatNameplate())
elseif isHuman then
nameplate.ENTITY:setText(HumanNameplate)
end
end

local wasTyping = false
local wasUnfocused = false

chosenSit = function ()
if isCat then
return catSitPose
else
return humanSitPose
end
end


function events.tick()
local isTyping = host:isChatOpen()
local isUnfocused = not client.isWindowFocused()
if wasTyping ~= isTyping and isTyping then
pings.typing()
elseif wasUnfocused ~= isUnfocused and isUnfocused then
pings.afk()
pings.deathPlay()
elseif wasTyping ~= isTyping and not isTyping then
if wasUnfocused ~= isUnfocused and isUnfocused then
pings.afk()
else
pings.defaultNP()
end
elseif wasUnfocused ~= isUnfocused and not isUnfocused then
if wasTyping ~= isTyping and isTyping then
pings.typing()
else
pings.defaultNP()
pings.deathStop()
end
end
wasTyping = isTyping
wasUnfocused = isUnfocused
LockMovement = deathPose:isPlaying()

if math.random(10000) == 1 then
pings.meow()
end

if player:isLoaded() then
chosenSit():setPlaying(not not player:getVehicle())
end
end

